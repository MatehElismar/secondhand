# ── REST API (only used by `npm run api` / `npm run api:dev`) ──────────
# Port the REST API listens on.
PORT=3000
# Alias for PORT, if you prefer an API-specific name.
# API_PORT=3000
# Network interface to bind. Use 0.0.0.0 to accept remote connections.
HOST=0.0.0.0
# Fastify log level: trace | debug | info | warn | error | silent
LOG_LEVEL=info

# ── Marketplace selection ─────────────────────────────────────────────
# Comma-separated list of marketplaces to enable. Leave unset to enable all
# that are usable on this machine. Valid values: facebook, ebay, depop, poshmark.
# If eBay keys are missing or Chrome is absent, eBay / Depop / Poshmark are
# skipped automatically.
# MARKETPLACES=facebook,ebay

# ── Facebook Marketplace ──────────────────────────────────────────────
# Optional residential proxy URL for Facebook requests. Leaving this unset runs
# from your machine's own IP, which Facebook may rate-limit faster.
# Format: http://user:pass@host:port
# SMARTPROXY_URL=

# Optional logged-in Facebook session. Facebook returns a gated/empty search
# feed to unauthenticated callers (so the adapter falls back to the single
# HTML page); a session fixes the GraphQL feed and enables pagination past 24.
# Export these from your browser (DevTools → Application → Cookies, and copy
# fb_dtsg / lsd from a /api/graphql request). Keep them local/secret.
# FB_COOKIE=
# FB_DTSG=
# FB_LSD=
# FB_USER=
# FB_JAZOEST=

# ── eBay (official Browse API) ────────────────────────────────────────
# Required for eBay search. Create a free developer app at developer.ebay.com.
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# Regional marketplace. Defaults to EBAY_US.
# EBAY_MARKETPLACE_ID=EBAY_US
# Use eBay sandbox (api.sandbox.ebay.com) when your keys are SBX-… (or the client
# id contains "-SBX-"). Default false = production.
# EBAY_SANDBOX=false

# ── Depop / Poshmark (headless browser) ───────────────────────────────
# Path to the Chrome/Chromium executable. If unset, the server auto-detects a
# system install. Useful in Docker and CI.
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
